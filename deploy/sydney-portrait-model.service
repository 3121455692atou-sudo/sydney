[Unit]
Description=bonsai-2-Sydney model (Prism llama-server + LoRA)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/bonsai-2-sydney
ExecStart=%h/bonsai-2-sydney/llama.cpp/build/bin/llama-server --model %h/bonsai-2-sydney/Ternary-Bonsai-2-27B-Uncensored-Heretic-v2-PQ2_0.gguf --lora %h/bonsai-2-sydney/bonsai-2-Sydney-LoRA-F16.gguf --alias sydney-bonsai --host 127.0.0.1 --port 8099 --api-key-file %h/.config/sydney/api-key.txt --n-gpu-layers all --ctx-size 16384 --parallel 1 --jinja --reasoning-format deepseek
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
